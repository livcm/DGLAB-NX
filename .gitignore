build/
release/
*.elf
*.nso
*.npdm
*.nsp
*.nro
*.nacp
*.map
*.o
*.d

# Atmosphère install directory generated by `make package` in sysmodule/.
# The directory name is the 16-hex-digit Title ID, which is defined in
# sysmodule/DGLAB-NX.json and deliberately not duplicated here.
sysmodule/[0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F]/

# Safety net in case a protocol reference clone ends up here. The standard
# location is the sibling directory ../dglab-bluetooth-protocol,
# see docs/dglab-protocol.md.
reference/

# macOS
.DS_Store

# Editors
.vscode/
.idea/
*.swp
