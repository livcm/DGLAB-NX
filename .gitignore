# Build outputs
build/
*.elf
*.nso
*.npdm
*.nsp
*.nro
*.nacp
*.map
*.o
*.d

# Atmosphère install directory generated by `make package` in sysmodule/.
# The directory name is the 16-hex-digit Title ID, which is defined in
# sysmodule/DGLAB-NX-Core.json and deliberately not duplicated here.
sysmodule/[0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F]/

# Safety net in case a protocol reference clone ends up here. The standard
# location is the sibling directory ../dglab-bluetooth-protocol,
# see docs/dglab-protocol.md.
reference/

# Firmware, keys and extraction results used by the read-only Bluetooth
# reverse engineering (tools/ble-re/, docs/ble-re.md). None of this may be
# committed: it is copyrighted firmware and console-specific key material.
*.nca
*.keys
prod.keys
tools/ble-re/work/
tools/ble-re/out/

# macOS
.DS_Store

# Editors
.vscode/
.idea/
*.swp

# Python bytecode caches (tools/ble-re/)
__pycache__/
